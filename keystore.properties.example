# Copy this file to keystore.properties (gitignored) and fill in real values.
# Then run:  ./gradlew :app:bundleRelease
#
# To create the keystore (one-time, on a machine you control), run:
#
#   keytool -genkeypair -v \
#     -keystore rooster-release.jks \
#     -keyalg RSA -keysize 4096 -validity 25000 \
#     -alias rooster
#
# Back up the resulting .jks file AND the passwords somewhere safe and offline.
# If you lose them you cannot publish updates to this app on Google Play, ever.

storeFile=rooster-release.jks
storePassword=CHANGE_ME
keyAlias=rooster
keyPassword=CHANGE_ME
